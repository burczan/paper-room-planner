{
  "name": "paper-room-planner",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc && node scripts/copyAssets.ts",
    "generate:examples": "node scripts/generateExamples.ts",
    "generate": "npm run build && node dist/cli/main.js",
    "lint": "oxlint",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write .",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --exclude 'dist/**'",
    "test": "vitest run --exclude 'dist/**'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "opentype.js": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/opentype.js": "^1.3.10",
    "@vitest/coverage-v8": "^5.0.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
